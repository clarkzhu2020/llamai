# LocalMAI Configuration

# HuggingFace API Token (for HF inference API)
HF_TOKEN=

# API Authentication Key (optional, leave empty to disable auth)
LOCALMAI_API_KEY=

# Ollama Server URL
OLLAMA_BASE_URL=http://localhost:11434

# Llama.cpp Server URL (for GGUF format models)
LLAMA_CPP_URL=http://localhost:8080

# vLLM Server URL (for high-throughput inference)
VLLM_URL=http://localhost:8000

# LTX-Video Server URL (for video+audio generation via ComfyUI)
LTX_VIDEO_URL=http://localhost:8188

# Stable Diffusion WebUI URL
SD_WEBUI_URL=http://localhost:7860

# Server Port
PORT=8080

# OpenAI Compatible API Port
OPENAI_API_PORT=8081

# GPU Memory (only used when no NVIDIA GPU is detected)
# GPU_MEMORY_MB=16000
